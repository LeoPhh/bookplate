{
  "name": "bookplate",
  "version": "1.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "test": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:all": "vitest run",
    "reset-password": "node --env-file-if-exists=.env.local scripts/reset-password.mjs",
    "remove-showcase": "node --env-file-if-exists=.env.local scripts/remove-showcase.mjs",
    "test:api:s3": "TEST_STORAGE=s3 vitest run --project api"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-list": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "altcha-lib": "^2.5.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "markdown-it": "^14.3.2",
    "next": "16.2.10",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.2",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^13.0.9",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "private": true
}
