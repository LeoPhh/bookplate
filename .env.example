# Copy to .env next to docker-compose.yml and fill in.

# Signs session cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Password for the bundled Postgres database. Generate one with:  openssl rand -hex 24
DB_PASSWORD=

# The address you'll open Bookplate at — e.g. https://books.example.com or
# http://192.168.1.20:3000. Sign-in cookies are marked secure when this is https.
PUBLIC_URL=http://localhost:3000

# Port on the host machine.
BOOKPLATE_PORT=3000

# "closed" (default): only the first account — yours — can be created.
# "open": anyone who can reach the server can sign up for their own library.
REGISTRATION=closed

# Email (optional). With it, people can reset a forgotten password from the
# sign-in page, and with REGISTRATION=open new accounts confirm their address.
# Without it, reset passwords on the server:
#   docker compose exec bookplate reset-password you@example.com
# Links in emails point at PUBLIC_URL, so make sure that's the address you use.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Bookplate <books@example.com>
# Where replies to Bookplate's emails go, if SMTP_FROM is an address nobody
# reads (e.g. no-reply@). The emails then say "Questions? Just reply".
# SMTP_REPLY_TO=Bookplate Support <support@example.com>
# Most emails the server sends in a day (UTC), all kinds together — a safety
# net if someone abuses sign-ups or resets. Unset or 0 = no cap.
# EMAIL_LIMIT_PER_DAY=1000

# Image storage (optional). Covers, pasted note images and profile photos are
# kept on disk in the "uploads" volume by default. To keep them in an
# S3-compatible bucket instead (Scaleway, Cloudflare R2, Backblaze B2, AWS, or
# a NAS running Garage/RustFS), set STORAGE=s3 and fill these in. Choose before
# adding images — switching later means export, switch, import.
# STORAGE=s3
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# S3_BUCKET=bookplate-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true   # usually needed for self-hosted S3 servers
# S3_PREFIX=                 # optional folder inside the bucket

# With REGISTRATION=open, strangers can sign up. Bookplate then:
#   - asks each sign-up's browser to solve a small invisible puzzle, so
#     scripts can't create accounts in bulk (SIGNUP_BOT_CHECK=false turns it off)
#   - allows at most 5 new accounts an hour from one address. Behind more than
#     one proxy (e.g. Cloudflare in front of Caddy), set TRUSTED_PROXIES=2 so
#     it finds the visitor's real address.
#   - removes accounts that never confirmed their email after 7 days (with email set up)
# TRUSTED_PROXIES=1

# Limits for each account (unset = no limit, apart from the defaults shown):
# LIMIT_BOOKS=5000
# LIMIT_WORDS=5000
# LIMIT_STORAGE_MB=500        # all of one account's images together
# LIMIT_UPLOAD_MB=8           # one image (default 8)
# LIMIT_IMPORT_MB=1024        # one export zip or CSV (default 1024)

# Your email, sent to Open Library with book searches. They allow three times
# as many requests from apps that give a contact, which helps busy servers.
# Showcases' "Report this page" links write to it too (hidden without one).
# CONTACT_EMAIL=you@example.com

# How much the server logs: debug, info (default), warn or error.
# LOG_LEVEL=info

# Totals for a dashboard (accounts, active people, books…) at /api/metrics,
# for a collector such as Grafana Alloy or Prometheus. Off unless set; the
# collector sends it as "Authorization: Bearer <token>". Make one with:
#   openssl rand -hex 32
# METRICS_TOKEN=
# How often the totals are recounted, in minutes (default 480 = 8 hours).
# METRICS_REFRESH_MINUTES=480

# A contact form's back end at /api/contact, for a website on the same domain
# (README → "Contact form"): messages are emailed here. Needs SMTP_HOST.
# CONTACT_FORM_TO=Bookplate <you@example.com>

# Offer a newsletter: an unticked box at sign-up and in Settings. Bookplate
# records who agreed and when; sending it is up to you. Mention it in your
# privacy policy.
# NEWSLETTER=true

# A privacy policy and terms, shown at /privacy and /terms and linked from
# sign-in and sign-up: privacy.md and/or terms.md (Markdown; the first
# "# " heading is the title) in a folder. With Docker, also uncomment the
# ./legal volume in docker-compose.yml and keep this at /legal.
# LEGAL_DIR=/legal
# Or, if you publish them on another site, their addresses. Sign-in and sign-up
# link there, and /privacy and /terms send visitors there.
# PRIVACY_URL=https://example.com/privacy
# TERMS_URL=https://example.com/terms

# Pin a version instead of following latest, e.g. 0.1.0
# BOOKPLATE_VERSION=latest

# Pull from GitHub's registry instead of Docker Hub:
# BOOKPLATE_IMAGE=ghcr.io/leophh/bookplate
